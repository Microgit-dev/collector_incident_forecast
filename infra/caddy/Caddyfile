{
	# Метрики Caddy для Prometheus
	metrics
	email noreply@gmail.com
	acme_dns duckdns {env.DUCKDNS_TOKEN}
}

# SPA и заголовки безопасности (корень и подсистема /training/)
(spa) {
	# SPA: неизвестные пути отдаются index.html, маршрутизирует React Router
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# Интерфейс: скрипты только свои (XSS не подгрузит чужой код), в iframe не встраивается.
		# 'unsafe-inline' для стилей — Mantine задаёт стили атрибутами style; скриптов это не касается.
		# MAP_TILES_ORIGIN — сервер подложки карты мониторинга (стиль, тайлы, шрифты подписей); для своего
		# сервера тайлов меняется вместе с MAP_STYLE_LIGHT/DARK в .env. MAP_SATELLITE_ORIGIN — спутниковая
		# подложка редактора объектов и планов этажей (MAP_SATELLITE_TILES)
		# connect-src blob: — планы этажей: MapLibre читает картинку плана из blob-URL через fetch
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$MAP_TILES_ORIGIN:https://tiles.versatiles.org} {$MAP_SATELLITE_ORIGIN:https://server.arcgisonline.com}; font-src 'self' data:; connect-src 'self' blob: {$MAP_TILES_ORIGIN:https://tiles.versatiles.org} {$MAP_SATELLITE_ORIGIN:https://server.arcgisonline.com}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# Панели наблюдаемости рабочего контура: вход через учётную запись системы, без своих паролей.
# Перед каждым запросом Caddy спрашивает бэкенд (apps/accounts/observability.py): подписанная cookie
# сеанса, активная учётка, право роли. Ответ 200 несёт X-WEBAUTH-*, по ним Grafana входит (auth.proxy).
# Заголовки X-WEBAUTH-* от клиента удаляются до проверки — подделать вход ими нельзя.
(observability) {
	handle /grafana* {
		route {
			request_header -X-WEBAUTH-USER
			request_header -X-WEBAUTH-NAME
			request_header -X-WEBAUTH-EMAIL
			request_header -X-WEBAUTH-ROLE
			forward_auth backend:8000 {
				uri /api/v1/observability/auth/?service=grafana
				copy_headers X-WEBAUTH-USER X-WEBAUTH-NAME X-WEBAUTH-EMAIL X-WEBAUTH-ROLE
			}
			reverse_proxy grafana:3000
		}
	}

	# Prometheus — только администратору
	handle /prometheus* {
		route {
			forward_auth backend:8000 {
				uri /api/v1/observability/auth/?service=prometheus
			}
			reverse_proxy prometheus:9090
		}
	}
}

# Платформа целиком на одном адресе: основная система в корне, учебный контур — подсистема /training/
# со своим бэкендом, базой и help desk, но с тем же входом (токен основной системы) и тем же интерфейсом.
(platform) {
	encode zstd gzip

	@backend path /api/* /admin/* /static/* /media/* /health/ /ws/*
	handle @backend {
		reverse_proxy backend:8000
	}

	import observability

	# Веб-интерфейс симулятора датчиков (профиль training): руководителю учений, вход тем же сеансом,
	# что и панели наблюдаемости. Префикс снимается — у симулятора свои пути /api/*
	redir /simulator /simulator/
	handle_path /simulator/* {
		route {
			forward_auth backend:8000 {
				uri /api/v1/observability/auth/?service=simulator
			}
			reverse_proxy simulator:8095
		}
	}

	# Эмулятор help desk заказчика (страница заявок «с их стороны»)
	handle_path /helpdesk* {
		reverse_proxy mock-helpdesk:8080
	}

	# Эмулятор видеонаблюдения: страница просмотра камеры (у заказчика — ссылка на его VMS, VMS_LIVE_URL)
	handle /vms/* {
		reverse_proxy mock-vms:8080
	}

	# Учебный контур (профиль training): префикс снимается, бэкенд строит ссылки админки с ним
	# (FORCE_SCRIPT_NAME). Статика админки и ресурсы интерфейса общие — берутся из корня.
	redir /training /training/
	handle_path /training/* {
		@training-backend path /api/* /admin/* /media/* /health/ /ws/*
		handle @training-backend {
			reverse_proxy backend-training:8000
		}
		handle_path /helpdesk* {
			reverse_proxy mock-helpdesk-training:8080
		}
		import spa
	}

	import spa
}

# Прежний отдельный адрес учебного контура (порт 8443) ведёт в подсистему /training/
(training-redirect) {
	redir https://{host}/training{uri} 302
}

{$SITE_ADDRESS} {
	import platform
}

{$TRAINING_ADDRESS} {
	import training-redirect
}

# TLS 1.2+ (ТЗ §11 — шифрование при передаче). Адреса и сертификат задаются в .env:
#   SITE_ADDRESS     — имя сервера, по умолчанию localhost (стенд);
#   TLS              — internal (внутренний CA Caddy, по умолчанию) или пути к сертификату и ключу
#                      заказчика внутри контейнера: /certs/fullchain.pem /certs/privkey.pem
https://localhost, https://127.0.0.1 {
	tls {$TLS:internal}
	import platform
}

https://localhost:8443, https://127.0.0.1:8443 {
	tls {$TLS:internal}
	import training-redirect
}

:2019 {
	metrics /metrics
}
