{
	# Метрики Caddy для Prometheus
	metrics
}

# Общее для обоих контуров: SPA и заголовки безопасности
(spa) {
	# SPA: неизвестные пути отдаются index.html, маршрутизирует React Router
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# Интерфейс: скрипты только свои (XSS не подгрузит чужой код), в iframe не встраивается.
		# 'unsafe-inline' для стилей — Mantine задаёт стили атрибутами style; скриптов это не касается.
		# MAP_TILES_ORIGIN — сервер подложки карты мониторинга (стиль, тайлы, шрифты подписей); для своего
		# сервера тайлов меняется вместе с MAP_STYLE_LIGHT/DARK в .env
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$MAP_TILES_ORIGIN:https://tiles.versatiles.org}; font-src 'self' data:; connect-src 'self' {$MAP_TILES_ORIGIN:https://tiles.versatiles.org}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# TLS 1.2+ (ТЗ §11 — шифрование при передаче). Адреса и сертификат задаются в .env:
#   SITE_ADDRESS     — имя сервера, по умолчанию localhost (стенд);
#   TLS              — internal (внутренний CA Caddy, по умолчанию) или пути к сертификату и ключу
#                      заказчика внутри контейнера: /certs/fullchain.pem /certs/privkey.pem
{$SITE_ADDRESS:localhost, 127.0.0.1} {
	tls {$TLS:internal}
	encode zstd gzip

	@backend path /api/* /admin/* /static/* /media/* /health/ /ws/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Эмулятор help desk заказчика (страница заявок «с их стороны»)
	handle_path /helpdesk* {
		reverse_proxy mock-helpdesk:8080
	}

	import spa
}

# Учебный контур (профиль training): тот же интерфейс, свой бэкенд и help desk.
# Другой порт — другой origin, поэтому вход и токены учебного и боевого контуров не смешиваются.
{$TRAINING_ADDRESS:localhost:8443, 127.0.0.1:8443} {
	tls {$TLS:internal}
	encode zstd gzip

	@backend path /api/* /admin/* /static/* /media/* /health/ /ws/*
	handle @backend {
		reverse_proxy backend-training:8000
	}

	handle_path /helpdesk* {
		reverse_proxy mock-helpdesk-training:8080
	}

	import spa
}

:2019 {
	metrics /metrics
}
