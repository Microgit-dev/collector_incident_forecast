# Скопируйте в .env:  cp .env.example .env
# Значения по умолчанию подходят только для локального стенда. Для любого другого окружения:
#   SECRET_KEY — python -c "import secrets; print(secrets.token_urlsafe(64))"
#   сменить все пароли ниже, DEMO_USERS=false (иначе manage.py check не пропустит ключ по умолчанию).
# Развёртывание на серверах заказчика — docs/deployment.md, безопасность — docs/security.md

# Django
SECRET_KEY=change-me-please-long-random-string
DEBUG=false
# Имя сервера для пользователей; localhost и backend (проверки контейнеров) добавляются сами
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
# Демо-команды и сотрудники для стенда (пароль новых учёток); в эксплуатации — false
DEMO_USERS=true
DEMO_PASSWORD=Passw0rd!

# PostgreSQL + TimescaleDB
POSTGRES_DB=collector
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector
DATABASE_URL=postgres://collector:collector@db:5432/collector

# Redis / Celery / Channels
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_EVENTS=smvu.raw-events

# LDAP (тестовый OpenLDAP в compose вместо AD заказчика)
LDAP_ENABLED=true
LDAP_SERVER_URI=ldap://openldap:389
LDAP_BASE_DN=dc=collector,dc=local
LDAP_BIND_DN=cn=admin,dc=collector,dc=local
LDAP_BIND_PASSWORD=ldap-admin
# Для AD заказчика (значения по умолчанию — тестовый OpenLDAP):
# LDAP_SERVER_URI=ldaps://dc01.corp.local:636
# LDAP_START_TLS=false                                  # true — StartTLS поверх ldap://
# LDAP_CA_CERT=/certs/corp-ca.pem                       # корневой сертификат ЦС заказчика
# LDAP_USER_BASE=OU=Users,DC=corp,DC=local
# LDAP_USER_FILTER=(sAMAccountName=%(user)s)
# LDAP_GROUP_BASE=OU=Forecast,OU=Groups,DC=corp,DC=local
# LDAP_GROUP_FILTER=(objectClass=group)
# LDAP_GROUP_TYPE=ad                                    # ad | groupOfNames

# Интеграции с системами заказчика: режим mock/emulated — эмуляторы стенда (docs/integrations.md,
# docs/deployment.md, раздел 6). Состояние и проверка связи — страница «Интеграции» у администратора.
HELPDESK_MODE=mock                                      # mock | rest | off
HELPDESK_URL=http://mock-helpdesk:8080
# HELPDESK_TOKEN=
# HELPDESK_AUTH_SCHEME=Bearer                           # Bearer | Token | Basic (логин:пароль в токене)
# HELPDESK_SUBMIT_PATH=/api/tickets/
# HELPDESK_STATUS_PATH=/api/tickets/statuses/
# HELPDESK_STATUS_MAP={"Исполнено":"done","В работе":"in_progress"}
# HELPDESK_CA_CERT=/certs/corp-ca.pem
REGISTRY_MODE=emulated                                  # emulated | api | file
# REGISTRY_URL=https://assets.corp.local/api/equipment/
# REGISTRY_TOKEN=
VMS_MODE=mock                                           # mock | http | off
# VMS_URL=https://vms.corp.local
# VMS_TOKEN=
# VMS_SNAPSHOT_PATH=/api/cameras/{id}/snapshot
# VMS_LIVE_URL=https://vms.corp.local/live/{id}?t={at}
# Погода (открытый API Open-Meteo). Без интернета — выключить задачу погоды в админке (Periodic tasks)
# WEATHER_URL=https://archive-api.open-meteo.com/v1/archive
# Эмулятор help desk: минуты между стадиями (принята→назначена→в работе→выполнена→закрыта)
HELPDESK_STAGE_MINUTES=2,5,20,10

# Grafana: вход через учётную запись системы; пароль администратора нужен только сервису grafana-init
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin12345
# Роль БД только для чтения, под которой Grafana читает витрины
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=grafana-reader

# Адрес сайта и сертификат (подставляются в infra/caddy/Caddyfile)
# SITE_ADDRESS=forecast.corp.local                     # учебный контур — тот же адрес, путь /training/
# TRAINING_ADDRESS=forecast.corp.local:8443            # прежний адрес учебного контура: перенаправляет в /training/
# TLS=internal                                          # или /certs/fullchain.pem /certs/privkey.pem (infra/caddy/certs)

# Карта мониторинга: подложка OSM и автовыделение зданий. В закрытом контуре — свои серверы или пусто
# MAP_STYLE_LIGHT=https://tiles.versatiles.org/assets/styles/muted/style.json
# MAP_STYLE_DARK=https://tiles.versatiles.org/assets/styles/muted-dark/style.json
# MAP_TILES_ORIGIN=https://tiles.versatiles.org        # разрешается в CSP; должен совпадать с сервером стиля
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Порты на хосте
HTTP_PORT=80
HTTPS_PORT=443
KAFKA_UI_PORT=8081
# Прежний порт учебного контура (перенаправление в /training/) и симулятор датчиков (слушает только 127.0.0.1)
TRAINING_PORT=8443
SIMULATOR_PORT=8095
# Адрес симулятора для ссылки в меню инструктора
SIMULATOR_URL=http://localhost:8095

# Демо-поток: во сколько раз быстрее реального времени
REPLAY_SPEED=60
